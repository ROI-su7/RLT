<launch>
  <!-- 定义 mode 参数，默认值为 0,读取主从臂的消息，并转发到ROS -->
  <arg name="mode" default="0" />
  <arg name="auto_enable" default="true" />
  <arg name="mode2_feedback_timeout_s" default="0.10" />
  <arg name="mode2_publish_hz" default="200.0" />
  <arg name="mode2_restore_joint_tolerance_rad" default="0.03" />
  <arg name="mode2_restore_gripper_tolerance_m" default="0.005" />
  <arg name="mode2_alignment_joint_velocity_rad_s" default="0.05" />
  <arg name="mode2_alignment_gripper_velocity_m_s" default="0.01" />
  <arg name="mode2_alignment_timeout_s" default="30.0" />
  <arg name="mode2_alignment_tracking_tolerance_rad" default="0.05" />
  <arg name="mode2_leaders_preisolated" default="false" />
  <!-- 启动左侧机械臂节点 -->
    <node name="$(anon piper_left)" pkg="piper" type="piper_start_ms_node.py" output="screen">
      <param name="can_port" value="can_left" />
      <param name="mode" value="$(arg mode)" />
      <param name="auto_enable" value="$(arg auto_enable)" />
      <remap from="/puppet/arm_status" to="/puppet/arm_status_left" />
      <remap from="/puppet/joint_states" to="/puppet/joint_left" />
      <remap from="/master/joint_states" to="/master/joint_left" />
      <remap from="/puppet/end_pose" to="/puppet/end_pose_left" />
      <remap from="/pos_cmd" to="/puppet/pos_cmd_left" />
      <remap from="/puppet/end_pose_euler" to="/puppet/end_pose_euler_left" />
    </node>

  <!-- 启动右侧机械臂节点 -->
    <node name="$(anon piper_right)" pkg="piper" type="piper_start_ms_node.py" output="screen">
      <param name="can_port" value="can_right" />
      <param name="mode" value="$(arg mode)" />
      <param name="auto_enable" value="$(arg auto_enable)" />
      <remap from="/puppet/arm_status" to="/puppet/arm_status_right" />
      <remap from="/puppet/joint_states" to="/puppet/joint_right" />
      <remap from="/master/joint_states" to="/master/joint_right" />
      <remap from="/puppet/end_pose" to="/puppet/end_pose_right" />
      <remap from="/pos_cmd" to="/puppet/pos_cmd_right" />
      <remap from="/puppet/end_pose_euler" to="/puppet/end_pose_euler_right" />
    </node>

  <!-- mode 2 keeps the follower nodes' position-control path. The bridge is
       fail-closed unless both leaders were physically isolated, configured,
       and verified to emit 0x16x before launch. It never changes CAN roles. -->
  <group if="$(eval int(arg('mode')) == 2)">
    <node
        name="piper_mode2_bridge"
        pkg="piper"
        type="piper_mode2_ros_driver.py"
        output="screen"
        required="true">
      <param name="left_can" value="can_left" />
      <param name="right_can" value="can_right" />
      <param
          name="leaders_preisolated"
          value="$(arg mode2_leaders_preisolated)" />
      <param
          name="feedback_timeout_s"
          value="$(arg mode2_feedback_timeout_s)" />
      <param name="publish_hz" value="$(arg mode2_publish_hz)" />
      <param
          name="restore_joint_tolerance_rad"
          value="$(arg mode2_restore_joint_tolerance_rad)" />
      <param
          name="restore_gripper_tolerance_m"
          value="$(arg mode2_restore_gripper_tolerance_m)" />
      <param
          name="alignment_joint_velocity_rad_s"
          value="$(arg mode2_alignment_joint_velocity_rad_s)" />
      <param
          name="alignment_gripper_velocity_m_s"
          value="$(arg mode2_alignment_gripper_velocity_m_s)" />
      <param
          name="alignment_timeout_s"
          value="$(arg mode2_alignment_timeout_s)" />
      <param
          name="alignment_tracking_tolerance_rad"
          value="$(arg mode2_alignment_tracking_tolerance_rad)" />
    </node>
  </group>
</launch>
