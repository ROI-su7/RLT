diff --git a/src/piper/scripts/piper_can_tx_guard.py b/src/piper/scripts/piper_can_tx_guard.py
new file mode 100644
index 0000000..3603f0c
--- /dev/null
+++ b/src/piper/scripts/piper_can_tx_guard.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Notice a Piper CAN adapter that stopped transmitting, and its reset.
+
+The candleLight adapters (gs_usb, kernel 5.15) sometimes return the echo of a
+transmitted frame with its first bytes missing (dmesg: "Unexpected out of
+range echo id 0x01550000" is the echo of command frame 0x155 shifted by two
+bytes; "Unexpected unused echo id" is its aftermath). Every lost echo leaks
+one of gs_usb's 10 TX slots. Once all of them leak the netdev stays UP but
+transmits nothing: the arm holds its last target and piper_sdk reports
+SEND_MESSAGE_FAILED (100017) as soon as the 1000-frame qdisc is full.
+
+Closing the netdev frees every TX slot and drops the queued (stale)
+commands, while bitrate, restart-ms and txqueuelen survive, so
+``sudo ip link set <port> down && sudo ip link set <port> up`` recovers the
+adapter. piper_sdk's read thread exits on the ENETDOWN that causes (and a
+``can_config.sh`` rebind replaces the netdev), so the drivers reopen their
+SDK port when ``CanLinkWatch`` sees the link come back.
+"""
+
+import time
+
+
+def reset_command(can_port):
+    return "sudo ip link set {0} down && sudo ip link set {0} up".format(can_port)
+
+
+def _read_sysfs(path):
+    try:
+        with open(path) as stream:
+            return stream.read().strip()
+    except OSError:
+        return None  # The netdev itself vanished (USB disconnect, rebind).
+
+
+class CanTxGuard:
+    """Report commands being sent while tx_packets stays frozen.
+
+    ``poll`` returns ``"stalled"`` once when the counter stayed frozen for
+    ``stall_timeout`` while commands were sent, ``"resumed"`` when frames
+    flow again, and ``None`` otherwise.
+    """
+
+    CHECK_PERIOD = 0.1
+    # A command older than this means nothing is being commanded (disabled,
+    # HOLD without commands), so a frozen counter is expected.
+    COMMAND_ACTIVE = 0.2
+
+    def __init__(self, can_port, stall_timeout=0.5, clock=time.monotonic):
+        self.can_port = can_port
+        self.stall_timeout = stall_timeout
+        self._clock = clock
+        self._counter_path = "/sys/class/net/%s/statistics/tx_packets" % can_port
+        self._last_command_sent = 0.0
+        self._last_value = None
+        self._last_change = clock()
+        self._next_check = 0.0
+        self.stalled = False
+        self.last_value = None
+
+    def note_command_sent(self):
+        self._last_command_sent = self._clock()
+
+    def stalled_for(self):
+        return self._clock() - self._last_change
+
+    def poll(self):
+        now = self._clock()
+        if now < self._next_check:
+            return None
+        self._next_check = now + self.CHECK_PERIOD
+        raw = _read_sysfs(self._counter_path)
+        value = int(raw) if raw is not None and raw.isdigit() else None
+        self.last_value = value
+        if value is not None and value != self._last_value:
+            self._last_value = value
+            self._last_change = now
+            if self.stalled:
+                self.stalled = False
+                return "resumed"
+            return None
+        if now - self._last_command_sent > self.COMMAND_ACTIVE:
+            self._last_change = now
+            return None
+        if self.stalled or now - self._last_change < self.stall_timeout:
+            return None
+        self.stalled = True
+        return "stalled"
+
+
+class CanLinkWatch:
+    """Say once when the netdev is UP again after a down/up or re-creation.
+
+    ``ip link set down/up`` bumps ``carrier_changes``; a ``can_config.sh``
+    rebind gives the same name a new ``ifindex``. Either one leaves
+    piper_sdk without a working read thread.
+    """
+
+    CHECK_PERIOD = 0.1
+
+    def __init__(self, can_port, clock=time.monotonic):
+        self.can_port = can_port
+        self._clock = clock
+        self._base = "/sys/class/net/%s/" % can_port
+        self._next_check = 0.0
+        self._generation = self._read_generation()
+
+    def _read_generation(self):
+        if _read_sysfs(self._base + "operstate") != "up":
+            return None
+        return (
+            _read_sysfs(self._base + "ifindex"),
+            _read_sysfs(self._base + "carrier_changes"),
+        )
+
+    def poll(self):
+        now = self._clock()
+        if now < self._next_check:
+            return False
+        self._next_check = now + self.CHECK_PERIOD
+        generation = self._read_generation()
+        if generation is None or generation == self._generation:
+            return False
+        self._generation = generation
+        return True
diff --git a/src/piper/scripts/piper_collect_slave_node.py b/src/piper/scripts/piper_collect_slave_node.py
new file mode 100755
index 0000000..1f95239
--- /dev/null
+++ b/src/piper/scripts/piper_collect_slave_node.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Collection-only follower driver with verified enable recovery.
+
+The generic follower driver is shared by the legacy master/slave and inference
+profiles.  Keep those paths unchanged and add collection-specific supervision
+here instead.
+"""
+
+import threading
+import time
+
+import rospy
+from std_msgs.msg import Bool
+
+from piper_start_slave_node import C_PiperRosNode
+
+
+class CollectPiperRosNode(C_PiperRosNode):
+    """Report physical enable confirmation and retry while collection requests it."""
+
+    def __init__(self):
+        # C_PiperRosNode starts its subscriber threads during construction.  Hold
+        # the enable subscriber until the collection-only status publisher and
+        # retry state below are ready, including when its input topic is latched.
+        self._collection_ready = threading.Event()
+        self._follower_enabled_pub = None
+        self._collection_enable_attempting = False
+        self._next_enable_retry_at = float("inf")
+        self._enable_loss_started_at = 0.0
+        super().__init__()
+
+        self.enable_retry_backoff = float(
+            rospy.get_param("~collection_enable_retry_backoff_s", 1.0)
+        )
+        self.enable_status_poll_period = float(
+            rospy.get_param("~collection_enable_status_poll_s", 0.10)
+        )
+        self.enable_loss_grace = float(
+            rospy.get_param("~collection_enable_loss_grace_s", 0.50)
+        )
+        if min(
+            self.enable_retry_backoff,
+            self.enable_status_poll_period,
+            self.enable_loss_grace,
+        ) <= 0.0:
+            raise ValueError("collection enable supervision intervals must be positive")
+
+        self._follower_enabled_pub = rospy.Publisher(
+            "/teleop/follower_enabled", Bool, queue_size=1, latch=True
+        )
+        self._publish_enabled(False)
+        self._collection_ready.set()
+        self._enable_watchdog = threading.Thread(
+            target=self._enable_watchdog_loop,
+            name="collection-enable-{}".format(self.can_port),
+            daemon=True,
+        )
+        self._enable_watchdog.start()
+
+    def SubEnableThread(self):
+        self._collection_ready.wait()
+        super().SubEnableThread()
+
+    def _publish_enabled(self, enabled):
+        if self._follower_enabled_pub is not None:
+            self._follower_enabled_pub.publish(Bool(data=bool(enabled)))
+
+    def _enable_and_wait(self):
+        # Close the externally visible gate before seeding/re-enabling.  The mux
+        # will hold both followers at their last commanded poses until this arm
+        # has positively confirmed all six motor drivers again.
+        if self._collection_enable_attempting:
+            return False
+        self._collection_enable_attempting = True
+        try:
+            self._publish_enabled(False)
+            enabled = super()._enable_and_wait()
+            self._publish_enabled(enabled)
+            self._enable_loss_started_at = 0.0
+            self._next_enable_retry_at = time.monotonic() + self.enable_retry_backoff
+            return enabled
+        finally:
+            self._collection_enable_attempting = False
+
+    def _disable_and_wait(self):
+        self._publish_enabled(False)
+        return super()._disable_and_wait()
+
+    def enable_callback(self, enable_flag):
+        if bool(enable_flag.data):
+            self._next_enable_retry_at = time.monotonic() + self.enable_retry_backoff
+        else:
+            self._next_enable_retry_at = float("inf")
+            self._enable_loss_started_at = 0.0
+        super().enable_callback(enable_flag)
+        self._publish_enabled(self.GetEnableFlag())
+
+    def emergency_stop_callback(self, stop_flag):
+        if bool(stop_flag.data):
+            self._publish_enabled(False)
+        super().emergency_stop_callback(stop_flag)
+        self._publish_enabled(self.GetEnableFlag())
+
+    def _enable_watchdog_loop(self):
+        while not rospy.is_shutdown() and not self._shutting_down:
+            now = time.monotonic()
+            requested = self._enable_requested and not self._emergency_stop_active
+            if not requested:
+                self._enable_loss_started_at = 0.0
+                time.sleep(self.enable_status_poll_period)
+                continue
+
+            try:
+                states = self._supervised_enable_states()
+            except Exception as exc:
+                # Stale or unreadable feedback means the arm's real state is
+                # unknown.  Report it loudly and drop the externally visible
+                # confirmation so the mux stops issuing commands, rather than
+                # letting a frozen cache pass for a healthy arm.
+                rospy.logerr_throttle(
+                    1.0,
+                    "%s collection enable-status read failed: %s",
+                    self.can_port,
+                    exc,
+                )
+                self._publish_enabled(False)
+                time.sleep(self.enable_status_poll_period)
+                continue
+
+            if self.GetEnableFlag():
+                if all(states):
+                    self._enable_loss_started_at = 0.0
+                elif self._enable_loss_started_at <= 0.0:
+                    self._enable_loss_started_at = now
+                elif now - self._enable_loss_started_at >= self.enable_loss_grace:
+                    rospy.logerr(
+                        "%s lost physical enable confirmation; states=%s; "
+                        "holding collection and re-enabling from measured pose",
+                        self.can_port,
+                        states,
+                    )
+                    self._enable_and_wait()
+            elif (
+                not self._collection_enable_attempting
+                and now >= self._next_enable_retry_at
+            ):
+                rospy.logwarn(
+                    "%s collection enable is still unconfirmed; retrying safely",
+                    self.can_port,
+                )
+                self._enable_and_wait()
+
+            time.sleep(self.enable_status_poll_period)
+
+
+if __name__ == "__main__":
+    try:
+        piper = CollectPiperRosNode()
+        piper.Pubilsh()
+    except rospy.ROSInterruptException:
+        pass
