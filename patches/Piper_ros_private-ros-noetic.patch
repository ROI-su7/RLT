index 0000000..cf3f7df
--- /dev/null
+++ b/src/piper/test/test_can_tx_guard.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""Offline tests for CAN TX stall detection and link-reset detection.
+
+A fake sysfs directory stands in for /sys/class/net/<port>; no CAN socket is
+opened.
+"""
+
+import pathlib
+import sys
+import tempfile
+import unittest
+
+SCRIPTS = pathlib.Path(__file__).parents[1] / "scripts"
+sys.path.insert(0, str(SCRIPTS))
+
+import piper_can_tx_guard as guard_module  # noqa: E402
+
+
+class _Clock:
+    def __init__(self):
+        self.now = 100.0
+
+    def __call__(self):
+        return self.now
+
+
+class _FakeNet:
+    """A writable stand-in for /sys/class/net/<port>/."""
+
+    def __init__(self, root, port="can_l_follower"):
+        self.dir = pathlib.Path(root) / port
+        (self.dir / "statistics").mkdir(parents=True)
+        self.set(tx_packets=0, operstate="up", ifindex=16, carrier_changes=1)
+
+    def set(self, **values):
+        for name, value in values.items():
+            path = (
+                self.dir / "statistics" / name
+                if name == "tx_packets"
+                else self.dir / name
+            )
+            path.write_text("%s\n" % value)
+
+    def remove(self):
+        for path in sorted(self.dir.rglob("*"), reverse=True):
+            path.rmdir() if path.is_dir() else path.unlink()
+        self.dir.rmdir()
+
+
+class _Fixture(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.net = _FakeNet(self._tmp.name)
+        self.clock = _Clock()
+        prefix = self._tmp.name + "/"
+        self._original_read = guard_module._read_sysfs
+        guard_module._read_sysfs = lambda path: self._original_read(
+            path.replace("/sys/class/net/", prefix)
+        )
+
+    def tearDown(self):
+        guard_module._read_sysfs = self._original_read
+        self._tmp.cleanup()
+
+    def step(self, seconds, poll):
+        events = []
+        end = self.clock.now + seconds
+        while self.clock.now < end:
+            self.clock.now += 0.05
+            events.append(poll())
+        return [event for event in events if event]
+
+
+class CanTxGuardTest(_Fixture):
+    def setUp(self):
+        super().setUp()
+        self.guard = guard_module.CanTxGuard(
+            "can_l_follower", stall_timeout=0.5, clock=self.clock
+        )
+
+    def command_for(self, seconds, tx_flows):
+        events = []
+        end = self.clock.now + seconds
+        tx = 0
+        while self.clock.now < end:
+            self.clock.now += 0.01
+            self.guard.note_command_sent()
+            if tx_flows:
+                tx += 4
+                self.net.set(tx_packets=tx)
+            event = self.guard.poll()
+            if event:
+                events.append(event)
+        return events
+
+    def test_flowing_frames_are_not_a_stall(self):
+        self.assertEqual(self.command_for(3.0, tx_flows=True), [])
+
+    def test_frozen_counter_while_commanding_is_reported_once(self):
+        self.command_for(0.2, tx_flows=True)
+        self.assertEqual(self.command_for(3.0, tx_flows=False), ["stalled"])
+        self.assertTrue(self.guard.stalled)
+
+    def test_frames_flowing_again_report_resumed(self):
+        self.command_for(1.0, tx_flows=False)
+        self.net.set(tx_packets=999)
+        self.assertEqual(self.command_for(0.2, tx_flows=False), ["resumed"])
+        self.assertFalse(self.guard.stalled)
+
+    def test_frozen_counter_without_commands_is_expected(self):
+        self.assertEqual(self.step(3.0, self.guard.poll), [])
+
+    def test_vanished_netdev_while_commanding_is_a_stall(self):
+        self.net.remove()
+        self.assertEqual(self.command_for(1.0, tx_flows=False), ["stalled"])
+
+
+class CanLinkWatchTest(_Fixture):
+    def setUp(self):
+        super().setUp()
+        self.watch = guard_module.CanLinkWatch("can_l_follower", clock=self.clock)
+
+    def test_steady_link_needs_no_reopen(self):
+        self.assertEqual(self.step(1.0, self.watch.poll), [])
+
+    def test_down_up_reports_once_when_back_up(self):
+        self.net.set(operstate="down", carrier_changes=2)
+        self.assertEqual(self.step(0.5, self.watch.poll), [])
+        self.net.set(operstate="up", carrier_changes=3)
+        self.assertEqual(self.step(0.5, self.watch.poll), [True])
+
+    def test_down_up_between_polls_is_still_seen(self):
+        self.net.set(carrier_changes=3)
+        self.assertEqual(self.step(0.5, self.watch.poll), [True])
+
+    def test_rebind_with_new_ifindex_reports_once(self):
+        self.net.remove()
+        self.assertEqual(self.step(0.5, self.watch.poll), [])
+        self.net = _FakeNet(self._tmp.name)
+        self.net.set(ifindex=21)
+        self.assertEqual(self.step(0.5, self.watch.poll), [True])
+
+
+class ResetCommandTest(unittest.TestCase):
+    def test_reset_is_down_then_up_of_the_same_port(self):
+        self.assertEqual(
+            guard_module.reset_command("can_r_leader"),
+            "sudo ip link set can_r_leader down && "
+            "sudo ip link set can_r_leader up",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/src/piper/test/test_rlt_follower_mux.py b/src/piper/test/test_rlt_follower_mux.py
new file mode 100644
index 0000000..bd7b9b2
--- /dev/null
+++ b/src/piper/test/test_rlt_follower_mux.py
@@ -0,0 +1,149 @@
+"""Exercise actual follower mux state/commands without ROS or CAN."""
+
+import ast
+from pathlib import Path
+import math
+import threading
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock
+
+
+class FollowerMuxTests(unittest.TestCase):
+    def mux(self, stage2=True):
+        clock = [1.0]
+        stop = [False]
+        pubs = {}
+        def publisher(topic, *args, **kwargs):
+            pubs[topic] = Mock()
+            return pubs[topic]
+        def message(**kwargs):
+            return SimpleNamespace(header=SimpleNamespace(stamp=None), **kwargs)
+        rospy = SimpleNamespace(
+            get_param=lambda key, default: stage2 if key == '~rlt_stage2' else default,
+            Publisher=publisher, Subscriber=Mock(), logwarn=Mock(), logerr=Mock(),
+            loginfo=Mock(), logwarn_throttle=Mock(), logerr_throttle=Mock(),
+            Time=SimpleNamespace(now=lambda: clock[0]),
+            is_shutdown=lambda: stop[0],
+            Rate=lambda hz: SimpleNamespace(sleep=lambda: stop.__setitem__(0, True)),
+        )
+        source = Path(__file__).parents[1] / 'scripts' / 'piper_policy_follower_mux.py'
+        nodes = [n for n in ast.parse(source.read_text()).body if isinstance(n, ast.ClassDef)]
+        env = dict(rospy=rospy, math=math, threading=threading,
+                   time=SimpleNamespace(monotonic=lambda: clock[0]),
+                   Bool=message, Empty=message, String=message, JointState=message)
+        exec(compile(ast.Module(body=nodes, type_ignores=[]), str(source), 'exec'), env)
+        obj = env['PolicyFollowerMux']()
+        for side in ('left', 'right'):
+            obj._follower[side].update(message(position=[.1]*7))
+            obj._policy[side].update(message(position=[.2]*7))
+        obj._enable_callback(message(data=True))
+        return obj, clock, stop, pubs, message
+
+    def test_stage2_never_enables_before_i_even_with_policy(self):
+        obj, _, _, pubs, _ = self.mux()
+        obj.run()
+        self.assertFalse(obj._active)
+        self.assertFalse(pubs['/teleop/follower_enable'].publish.call_args.args[0].data)
+        self.assertEqual(obj._home_target['left'], [.1]*7)
+
+    def test_i_releases_seed_gate_and_captures_launch_home(self):
+        obj, _, _, pubs, message = self.mux()
+        obj._mode_callback(message(data='INFERENCE'))
+        self.assertEqual(obj._published_mode, 'INFERENCE')
+        self.assertFalse(obj._hold_active)
+        obj.run()
+        self.assertTrue(obj._active)
+        self.assertEqual(obj._home_target['right'], [.1]*7)
+        self.assertEqual(pubs['/teleop/command/joint_right'].publish.call_args.args[0].position, [.1]*7)
+        self.assertTrue(pubs['/teleop/follower_enable'].publish.call_args.args[0].data)
+
+    def test_home_uses_launch_pose_after_feedback_changes(self):
+        obj, clock, stop, _, message = self.mux()
+        obj._mode_callback(message(data='INFERENCE'))
+        obj.run()
+        clock[0] += .01
+        for side in ('left', 'right'):
+            obj._follower[side].update(message(position=[.3]*7))
+        obj._hold_callback(message())
+        obj._home_callback(message())
+        self.assertTrue(obj._home_active)
+        self.assertEqual(obj._home_target['left'], [.1]*7)
+        stop[0] = False
+        obj.run()
+        self.assertTrue(all(.1 <= value < .3 for value in obj._last_output['left']))
+        self.assertTrue(obj._hold_active)
+
+    def test_resume_waits_for_new_policy_and_t_is_ignored(self):
+        obj, clock, stop, _, message = self.mux()
+        obj._mode_callback(message(data='INFERENCE'))
+        obj.run()
+        obj._hold_callback(message())
+        clock[0] += .01
+        obj._mode_callback(message(data='TAKEOVER'))
+        self.assertTrue(obj._hold_active)
+        obj._mode_callback(message(data='INFERENCE'))
+        stop[0] = False
+        obj.run()
+        self.assertTrue(obj._resume_pending)
+        clock[0] += .01
+        for side in ('left', 'right'):
+            obj._policy[side].update(message(position=[.2]*7))
+        stop[0] = False
+        obj.run()
+        self.assertFalse(obj._resume_pending)
+
+    def test_ordinary_openpi_keeps_automatic_start(self):
+        obj, _, _, _, _ = self.mux(stage2=False)
+        obj.run()
+        self.assertTrue(obj._active)
+        self.assertEqual(obj._published_mode, 'INFERENCE_FOLLOWERS')
+
+    def test_feedback_gap_holds_without_estop_or_disable_in_all_stage2_phases(self):
+        for phase in ('inference', 'resync', 'hold', 'home'):
+            with self.subTest(phase=phase):
+                obj, clock, stop, pubs, message = self.mux()
+                obj._mode_callback(message(data='INFERENCE'))
+                obj.run()
+                if phase in ('resync', 'hold', 'home'):
+                    obj._hold_callback(message())
+                if phase == 'resync':
+                    obj._mode_callback(message(data='INFERENCE'))
+                if phase == 'home':
+                    obj._home_callback(message())
+                old = list(obj._last_output['right'])
+                clock[0] += .2  # Beyond the existing 150-ms RX threshold.
+                obj._follower['left'].update(message(position=[.1]*7))
+                stop[0] = False
+                obj.run()
+                self.assertFalse(obj._emergency_stop)
+                self.assertTrue(obj._active and obj._enable_requested)
+                self.assertTrue(obj._hold_active)
+                self.assertFalse(obj._home_active or obj._resume_pending)
+                self.assertEqual(obj._last_output['right'], old)
+                self.assertTrue(pubs['/teleop/follower_enable'].publish.call_args.args[0].data)
+                self.assertFalse(pubs['/teleop/emergency_stop'].publish.call_args.args[0].data)
+                self.assertEqual(pubs['/teleop/command/joint_right'].publish.call_args.args[0].position, old)
+                obj._mode_callback(message(data='INFERENCE'))
+                self.assertTrue(obj._hold_active)  # Stale I is refused.
+                clock[0] += .01
+                for side in ('left', 'right'):
+                    obj._follower[side].update(message(position=[.1]*7))
+                stop[0] = False
+                obj.run()
+                self.assertTrue(obj._hold_active)  # Recovery is not automatic.
+                obj._mode_callback(message(data='INFERENCE'))
+                self.assertTrue(obj._resume_pending)
+
+    def test_explicit_emergency_request_still_stops_and_disables(self):
+        obj, _, _, pubs, message = self.mux()
+        obj._mode_callback(message(data='INFERENCE'))
+        obj.run()
+        obj._emergency_callback(message())
+        self.assertTrue(obj._emergency_stop)
+        self.assertFalse(pubs['/teleop/follower_enable'].publish.call_args.args[0].data)
