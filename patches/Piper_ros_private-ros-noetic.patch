+# Whether the kernel logged a gs_usb echo-id fault for this USB interface
+# after the adapter was last (re)configured. Such an adapter can keep its
+# netdev UP and pass ethtool while it no longer transmits: the arm then holds
+# its last target and ignores every command.
+gs_usb_echo_fault_since_configure() {
+    local usb_interface="$1"
+    dmesg 2>/dev/null | awk -v dev="gs_usb $usb_interface" '
+        index($0, dev) {
+            if (index($0, "Configuring for")) faulted = 0
+            else if (index($0, "Unexpected unused echo id")) faulted = 1
+        }
+        END { exit faulted ? 0 : 1 }'
+}
+
 recover_stale_gs_usb_interfaces() {
     local iface
     local usb_interface
     local stale_interfaces=()
 
     # A candleLight/gs_usb echo-context failure can leave a netdev visible in
-    # `ip link` while ethtool and RTNETLINK return ENODEV. Recover only those
-    # stale adapters; healthy CAN devices and camera USB devices are untouched.
+    # `ip link` while ethtool and RTNETLINK return ENODEV, or keep it working
+    # for ethtool while transmission is stuck. Recover only those adapters;
+    # healthy CAN devices and camera USB devices are untouched.
     for iface in $(ip -br link show type can | awk '{print $1}'); do
+        usb_interface=$(basename "$(readlink -f "/sys/class/net/$iface/device")")
         if ethtool -i "$iface" >/dev/null 2>&1; then
+            if [ -z "$usb_interface" ] || \
+               ! gs_usb_echo_fault_since_configure "$usb_interface"; then
+                continue
+            fi
+            echo "检测到 gs_usb 接口 $iface ($usb_interface) 自上次配置后出现 echo id 错误（发送可能已卡死），将重新绑定驱动。"
+            stale_interfaces+=("$usb_interface")
             continue
         fi
-        usb_interface=$(basename "$(readlink -f "/sys/class/net/$iface/device")")
         if [ -z "$usb_interface" ] || \
            [ ! -e "/sys/bus/usb/drivers/gs_usb/$usb_interface" ]; then
             echo "错误: 接口 $iface 不可用，且无法确定对应的 gs_usb 设备。"
@@ -169,11 +190,11 @@ if [ "$EXPECTED_CAN_COUNT" -ne 1 ]; then
     declare -A USB_PORTS 
    # USB_PORTS["1-13:1.0"]="can_left:1000000"
    # USB_PORTS["1-12:1.0"]="can_right:1000000"
-    USB_PORTS["1-4.1:1.0"]="can0:500000"
-    USB_PORTS["1-13.1:1.0"]="can_l_leader:1000000"
-    USB_PORTS["1-13.4:1.0"]="can_l_follower:1000000"
-    USB_PORTS["1-13.3:1.0"]="can_r_leader:1000000"
-    USB_PORTS["1-4.2:1.0"]="can_r_follower:1000000"
+    #USB_PORTS["1-4:1.0"]="can0:500000"
+    USB_PORTS["1-13:1.0"]="can_l_leader:1000000"
+    USB_PORTS["1-12:1.0"]="can_l_follower:1000000"
+    USB_PORTS["1-1:1.0"]="can_r_leader:1000000"
+    USB_PORTS["1-4:1.0"]="can_r_follower:1000000"
 fi
 
 # Recover stale gs_usb netdevs before counting and mapping interfaces.
